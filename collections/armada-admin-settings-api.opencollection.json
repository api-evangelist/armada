{
  "opencollection": "1.0.0",
  "info": {
    "name": "Orchestrator Admin Settings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Admin Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get admin settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/settings"
          },
          "docs": "Get admin settings"
        },
        {
          "info": {
            "name": "Update admin settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "/settings"
          },
          "docs": "Update admin settings"
        }
      ]
    }
  ],
  "bundled": true
}