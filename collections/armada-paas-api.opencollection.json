{
  "opencollection": "1.0.0",
  "info": {
    "name": "Orchestrator Admin Settings PaaS API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "PaaS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create/initialize PaaS cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/tenants/:tenant/paas/initialize",
            "params": [
              {
                "name": "tenant",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create/initialize PaaS cluster"
        },
        {
          "info": {
            "name": "Get PaaS cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/tenants/:tenant/paas",
            "params": [
              {
                "name": "tenant",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get PaaS cluster"
        },
        {
          "info": {
            "name": "Teardown/delete PaaS cluster",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/tenants/:tenant/paas/teardown",
            "params": [
              {
                "name": "tenant",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Teardown/delete PaaS cluster"
        }
      ]
    }
  ],
  "bundled": true
}